# Canonical live field profile. Starting the service opens the command path but
# never sends ARM, changes mode, uploads a mission or starts movement itself.
IDA_WS=@IDA_WS@
IDA_CANONICAL_TAKEOVER=true
IDA_FIELD_DRY_RUN=false
IDA_MAVLINK_ROUTER_ENABLED=true
IDA_VEHICLE_SETUP_ENABLED=false
IDA_GUIDED_MODE_ENABLED=true
IDA_MOTOR_COMMAND_ENABLED=true

IDA_PIXHAWK_PORT=auto
IDA_PIXHAWK_BAUD=115200
IDA_LIDAR_PORT=auto

IDA_MODEL_PROFILE=

# Salt-okunur YKİ lidar/füzyon aktarımı, adres ve ayrı token doğrulanınca açılır.
# Bagimsiz ida-yki-perception.service kullanilir; launch icinde ikinci producer acilmaz.
IDA_YKI_DEBUG_ENABLED=false
IDA_YKI_DEBUG_WEBSOCKET_URL=auto://yki
EZEL_JETSON_DEBUG_TOKEN=

IDA_FIELD_CAMERA_DRIVER_ENABLED=true
IDA_FIELD_LIDAR_ENABLED=true
# /dev/videoN sırası Tegra kamera aygıtları nedeniyle reboot/USB yeniden takmada
# değişebilir. B0495'in kalıcı by-id yolu kullanılmalıdır.
IDA_FIELD_CAMERA_DEVICE=auto
IDA_CAMERA_TOPIC=/camera/image_raw
IDA_CAMERA_TOPIC_TYPE=raw

IDA_FUSION_MODEL_LOADED=true
IDA_CAMERA_CALIBRATED=true
IDA_LIDAR_CALIBRATED=true
IDA_EXTRINSICS_CALIBRATED=true
IDA_FIELD_REQUIRE_FUSION_READY=true

# Navigasyon, DWA, hız/yaw, limiter/bridge, kamera edinim ve görüntü,
# lidar geometrisi/taraması, füzyon ve loglama ayarlarının tek kaynağı:
# src/ida_bringup/config/field_profile.yaml
IDA_LEFT_MOTOR_SERVO_CHANNEL=9
IDA_RIGHT_MOTOR_SERVO_CHANNEL=11
IDA_TARGET_COLOR_PARAM=SCR_USER4
IDA_MISSION_COUNTS_PARAM=SCR_USER5
IDA_MISSION_CONTROL_PARAM=SCR_USER6
IDA_LOG_DIR=@IDA_WS@/logs
IDA_FIELD_PHYSICAL_SAFETY_ACK=FIELD_OPERATOR_READY_NO_AUTO_ARM
