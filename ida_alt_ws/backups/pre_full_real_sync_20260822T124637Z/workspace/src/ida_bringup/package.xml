<?xml version="1.0"?>
<package format="3">
  <name>ida_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration files for IDA autonomy.</description>
  <maintainer email="team@example.com">IDA Autonomy Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ida_autonomy</exec_depend>
  <exec_depend>ida_control</exec_depend>
  <exec_depend>ida_logging</exec_depend>
  <exec_depend>ida_planning</exec_depend>
  <exec_depend>ida_perception</exec_depend>
  <exec_depend>ida_perception_sim</exec_depend>
  <exec_depend>ida_sensor_fusion</exec_depend>
  <exec_depend>ida_telemetry_sim</exec_depend>
  <exec_depend>ida_uav_target</exec_depend>
  <exec_depend>ida_vehicle_test</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
