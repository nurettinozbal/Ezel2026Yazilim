# IDA canonical stack - Jetson bench aday ayarlari
#
# Bu dosya kendiliginden calismaz. Takim stack'inin yerine gecmez ve servis
# olusturmaz. Degerler ancak bilincli bir bench oturumunda `source` edilirse
# etkili olur.

# Fiziksel cihazlar benzersiz kalıcı kimlikle keşfedilir; numaralı tty yoktur.
export IDA_PIXHAWK_PORT=auto
export IDA_LIDAR_PORT=auto

# Takim stack'i SCR_USER1/2/3 kullanir. Canonical alternatif ayrik alanlardadir.
export IDA_TARGET_COLOR_PARAM=SCR_USER4
export IDA_MISSION_COUNTS_PARAM=SCR_USER5
export IDA_MISSION_CONTROL_PARAM=SCR_USER6

# Gercek motor cikislari: AUX1=SERVO9, AUX3=SERVO11.
export IDA_LEFT_MOTOR_SERVO_CHANNEL=9
export IDA_RIGHT_MOTOR_SERVO_CHANNEL=11

# Guvenli varsayilanlar: setup, GUIDED ve motor komut yolu kapali.
export IDA_CANONICAL_TAKEOVER=false
export IDA_VEHICLE_SETUP_ENABLED=false
export IDA_GUIDED_MODE_ENABLED=false
export IDA_MOTOR_COMMAND_ENABLED=false

# Kalibrasyon kaniti olmadan fusion canonical olarak hazir sayilmaz.
export IDA_FUSION_MODEL_LOADED=false
export IDA_CAMERA_CALIBRATED=false
export IDA_LIDAR_CALIBRATED=false
export IDA_EXTRINSICS_CALIBRATED=false

# Canonical general model; workspace path jetson_env.sh tarafindan bulunur.
export IDA_MODEL_P1P2="$IDA_WS/models/p3_candidates/general_yolo11s_20260808.pt"
export IDA_MODEL_P3="$IDA_MODEL_P1P2"
export IDA_MODEL_CLASS_NAMES=black,green,orange,red,yellow

# Bench-only Arducam source. 960x600@30 keeps two YOLO roles from building a
# latency queue; the sensor itself supports higher rates when profiling alone.
export IDA_BENCH_CAMERA_DRIVER_ENABLED=true
export IDA_BENCH_CAMERA_DEVICE=auto
export IDA_CAMERA_TOPIC=/camera/image_raw
export IDA_CAMERA_TOPIC_TYPE=raw
export IDA_BENCH_CAMERA_WIDTH=960
export IDA_BENCH_CAMERA_HEIGHT=600
export IDA_BENCH_CAMERA_FPS=30

# Sadece fiziksel guvenlik kontrolu sonrasi setup/GUIDED/motor acilacaksa:
# export IDA_PHYSICAL_SAFETY_ACK=PROPELLER_AREA_CLEAR
