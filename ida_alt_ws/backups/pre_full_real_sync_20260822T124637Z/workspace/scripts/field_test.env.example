# IDA canonical field service configuration.
#
# Copy to /etc/ida/field-test.env, edit deliberately, then start the service.
# Enabling the service at boot only starts the ROS field stack. It never sends
# ARM/GUIDED/START itself; those remain explicit YKI commands.

IDA_WS=@IDA_WS@

# Ownership/connection gates.  Keep false until the team stack is stopped and
# the devices are proven free.  vehicle_setup is permanently forbidden here.
IDA_CANONICAL_TAKEOVER=false
IDA_FIELD_DRY_RUN=true
IDA_MAVLINK_ROUTER_ENABLED=false
IDA_VEHICLE_SETUP_ENABLED=false
IDA_GUIDED_MODE_ENABLED=false
IDA_MOTOR_COMMAND_ENABLED=false

IDA_PIXHAWK_PORT=auto
IDA_PIXHAWK_BAUD=115200
IDA_LIDAR_PORT=auto

# General model is currently the better P1/P2 candidate.  Its native five-class
# order is declared honestly; allowed colors restrict this role to orange/yellow.
IDA_MODEL_P1P2=@IDA_WS@/models/p3_candidates/general_yolo11s_20260808.pt
IDA_MODEL_P1P2_SHA256=e3277e1778ec59e5af64cbeea81292fe97daefa6f0dc7bf1cc26780e24e93138
IDA_MODEL_P1P2_CLASS_NAMES=black,green,orange,red,yellow
IDA_MODEL_P1P2_ALLOWED_COLORS=orange,yellow
IDA_MODEL_P3=@IDA_WS@/models/p3_candidates/general_yolo11s_20260808.pt
IDA_MODEL_P3_SHA256=e3277e1778ec59e5af64cbeea81292fe97daefa6f0dc7bf1cc26780e24e93138
IDA_MODEL_P3_CLASS_NAMES=black,green,orange,red,yellow
IDA_MODEL_P3_ALLOWED_COLORS=red,green,black
IDA_SINGLE_GENERAL_MODEL_ENABLED=true

# YKİ lidar/füzyon paneli. Açıldığında yalnız salt-okunur teşhis verisi yollar.
# EZEL_JETSON_DEBUG_TOKEN ayrıca bu env dosyasında tanımlanmalı ve YKİ backend
# tarafındaki aynı adlı değere eşit, browser komut anahtarından farklı olmalıdır.
# Salt-okunur lidar/fuzyon akisi. Arac testi veya motor yetkisi vermez.
# Ham lidar/costmap YKİ'ye Wi-Fi/WebSocket ile aktarılmaz.
IDA_YKI_DEBUG_ENABLED=false
IDA_YKI_DEBUG_WEBSOCKET_URL=auto://yki
EZEL_JETSON_DEBUG_TOKEN=

# Gercek adres ve tokeni repoya yazmayin. Jetson'da bunlari
# /etc/ida/field-test.local.env icinde override edin.

IDA_FIELD_CAMERA_DRIVER_ENABLED=true
IDA_FIELD_LIDAR_ENABLED=true
IDA_FIELD_CAMERA_DEVICE=auto
IDA_CAMERA_TOPIC=/camera/image_raw
IDA_CAMERA_TOPIC_TYPE=raw

# These four values may be true only after the corresponding bench evidence is
# accepted.  Full canonical fusion refuses to start while one is false.
IDA_FUSION_MODEL_LOADED=false
IDA_CAMERA_CALIBRATED=false
IDA_LIDAR_CALIBRATED=false
IDA_EXTRINSICS_CALIBRATED=false
IDA_FIELD_REQUIRE_FUSION_READY=true

# Navigasyon, DWA, hız/yaw, limiter/bridge, kamera, lidar, füzyon ve loglama
# ayarları yalnız config/field_profile.yaml içindedir.
IDA_LEFT_MOTOR_SERVO_CHANNEL=9
IDA_RIGHT_MOTOR_SERVO_CHANNEL=11
IDA_TARGET_COLOR_PARAM=SCR_USER4
IDA_MISSION_COUNTS_PARAM=SCR_USER5
IDA_MISSION_CONTROL_PARAM=SCR_USER6
IDA_LOG_DIR=@IDA_WS@/logs

# Required only when MOTOR_COMMAND_ENABLED=true.  This opens the command path;
# it still does not ARM or start a mission.
IDA_FIELD_PHYSICAL_SAFETY_ACK=


