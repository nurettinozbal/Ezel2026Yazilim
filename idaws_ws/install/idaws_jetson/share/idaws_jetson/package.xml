<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>idaws_jetson</name>
  <version>1.0.0</version>
  <description>IDAWS gerçek araç dağıtımı: Slamtec LiDAR entegrasyonu, tarama hizalama ve saha launch dosyaları</description>
  <maintainer email="team@idaws.dev">IDAWS Team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Aynı workspace'e klonlanır: install.sh ikisini de getirir -->
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>idaws_nodes</exec_depend>
  <exec_depend>idaws_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
